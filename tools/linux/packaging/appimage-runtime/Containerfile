# AppImage type2 runtime toolchain: digest-pinned Alpine 3.21.8 (linux/amd64)
# and exact apk versions. Compilation itself runs with --network=none; every
# compiled library comes from a hash-verified tarball (manifest.json), not apk.
# musl/musl-dev are the libc incorporated into the static runtime; they must
# stay equal to the base image's musl (manifest.json "musl").
FROM docker.io/library/alpine:3.21.8@sha256:3c81aa9a3d770b316568f4499e30461a5cd3fbd7180bd89e28e34894c7845832

RUN apk add --no-cache \
        musl=1.2.5-r11 musl-dev=1.2.5-r11 \
        clang19=19.1.4-r0 gcc=14.2.0-r4 binutils=2.43.1-r3 linux-headers=6.6-r1 \
        make=4.4.1-r2 cmake=3.31.1-r0 meson=1.6.1-r0 samurai=1.2-r6 \
        autoconf=2.72-r0 automake=1.17-r0 libtool=2.4.7-r3 pkgconf=2.3.0-r0 \
        patch=2.7.6-r10 tar=1.35-r2 xz=5.8.4-r0 file=5.46-r2 \
    && command -v clang
