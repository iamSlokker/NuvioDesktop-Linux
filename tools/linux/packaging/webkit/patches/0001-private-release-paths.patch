@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: BSD-2-Clause
+// Nuvio's AppImage-only WebKit build. No environment or system-path fallback.
+#pragma once
+#include <dlfcn.h>
+#include <glib.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static const char* nuvioPackageRoot() __attribute__((noinline));
+static const char* nuvioPackageRoot()
+{
+    static const char* root = [] {
+        Dl_info info { };
+        if (!dladdr(reinterpret_cast<void*>(&nuvioPackageRoot), &info) || !info.dli_fname)
+            g_error("Nuvio WebKit: cannot locate private engine");
+        char* library = realpath(info.dli_fname, nullptr);
+        if (!library)
+            g_error("Nuvio WebKit: private engine path is unavailable");
+        char* directory = g_path_get_dirname(library);
+        free(library);
+        const char* suffix = g_str_has_suffix(directory, "/lib/native") ? "/lib/native" : "/lib/webkit2gtk-4.1";
+        if (!g_str_has_suffix(directory, suffix) || strlen(directory) == strlen(suffix))
+            g_error("Nuvio WebKit: engine/helper must be inside its private directory");
+        directory[strlen(directory) - strlen(suffix)] = '\0';
+        const char* result = g_intern_string(directory);
+        g_free(directory);
+        return result;
+    }();
+    return root;
+}
+
+static inline const char* nuvioPrivatePath(const char* relative, bool executable = false)
+{
+    char* candidate = g_build_filename(nuvioPackageRoot(), relative, nullptr);
+    char* resolved = realpath(candidate, nullptr);
+    g_free(candidate);
+    char* prefix = g_strconcat(nuvioPackageRoot(), "/", nullptr);
+    if (!resolved || !g_str_has_prefix(resolved, prefix))
+        g_error("Nuvio WebKit: missing or escaping private resource: %s", relative);
+    g_free(prefix);
+    struct stat status { };
+    if (stat(resolved, &status) || access(resolved, R_OK)
+        || (executable && (!S_ISREG(status.st_mode) || access(resolved, X_OK)
+            || (status.st_mode & (S_ISUID | S_ISGID)))))
+        g_error("Nuvio WebKit: invalid private resource permissions: %s", relative);
+    const char* result = g_intern_string(resolved);
+    free(resolved);
+    return result;
+}
